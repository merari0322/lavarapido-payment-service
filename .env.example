# Copiar a .env (misma carpeta) y llenar. .env está en .gitignore: nunca subir secretos reales.
# Lo lee docker compose de este repo (base aislada para las pruebas de integración, puerto 1434).

# Contraseña de "sa" de la base aislada. SQL Server rechaza las débiles: 8+ caracteres con
# mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=<cambia-esta-contraseña>
